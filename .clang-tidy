---
# Opt-in C analysis profile, not an executed CI analyzer gate. See tooling-policy.
Checks: '-*,clang-diagnostic-*,clang-analyzer-core.*,clang-analyzer-unix.*,clang-analyzer-security.*,-clang-analyzer-security.insecureAPI.*'
WarningsAsErrors: ''
HeaderFilterRegex: '(^|/)(include|src)/.*\.h$'
FormatStyle: file
