    "benchmark": "python3 bench/run_rpc_repeatability.py --binary <release-binary> --output <workspace-output> --label <label> --trials 3 --rate 40000",
    "temporary_environment": "TMPDIR=$PWD/build/test-tmp XMAKE_TMPDIR=$PWD/build/test-tmp PYTHONDONTWRITEBYTECODE=1",
    "gcc": "xmake b -P . --all -j4 && xmake test -P . -v -j1",
    "asan_ubsan": "xmake f -P . -c -y -m asan --toolchain=gcc -o build/perf-v2-01/asan; build then xmake test -P . -v test_channel_drain/* and test_stream_reset/*"
  }
}
